<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit <%= Products.name %></title>
  </head>
  <body>
    <!-- cheeck this finished  -->

  <!-- edit one product -->



    <%- include('../partials/_navbar.ejs') %>
    <h1>Edit a Products!</h1>
    <form action="/Products/<%= Products._id %>?_method=PUT" method="POST">

      <label for="name ">name:</label>
      <input type="text" name="name" id="name" value="<%= products.name %>"/>

      <label for="description">description:</label>
      <input type="text" name="price" id="price" value="<%= products.description %>"/>

      <label for="price">Price :</label>
      <input type="number" name="Price" id="Price" value="<%= products.price %>"/>


      <label for="brand">Brand:</label>
      <input type="text" name="Brand" id="Brand" value="<%= products.Brand>"/>


      <label for="category">Category:</label>
      <input type="text" name="Category" id="Category" value="<%= products.Category %>"/>



      <button type="submit">Edit Products</button>
    </form>
  </body>
</html>